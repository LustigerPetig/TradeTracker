{
	"schemaVersion": 1,
	"id": "tradetracker",
	"version": "${version}",
	"name": "Trade Tracker",
	"description": "A mod made to help you find the trades you are looking for!",
	"authors": [
		"LusterPetig, Shadow_of_Doom03"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/LustigerPetig/TradeTracker",
		"issues": "https://github.com/LusterPetig/TradeTracker/issues"
	},
	"license": "GNU GPL-3.0",
	"icon": "assets/tradetracker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "trade.tracker.TradeTracker"

			}
		],
		"client": [
			{
				"value": "trade.tracker.client.TradeTrackerClient"

			}
		],
		"modmenu": [
			"trade.tracker.client.TradeTrackerModMenu"
		]


	},
	"mixins": [
		"tradetracker.json",
		{
			"config": "tradetracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	}
}