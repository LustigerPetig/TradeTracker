{
	"schemaVersion": 1,
	"id": "jasperbot",
	"version": "${version}",
	"name": "Trade Tracker",
	"description": "A mod made to help you find the trades you are looking for!",
	"authors": [
		"LusterPetig, Shadow_of_Doom03"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/LustigerPetig/JasperBot"
	},
	"license": "CC0-1.0",
	"icon": "assets/jasperbot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "jasper.bot.JasperBot",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "jasper.bot.client.TradeTrackerClient",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			"jasper.bot.client.TradeTrackerModMenu"
		],
		"fabric-datagen": [
			{
				"value": "jasper.bot.client.JasperBotDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"jasperbot.mixins.json",
		{
			"config": "jasperbot.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}