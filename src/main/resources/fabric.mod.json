{
	"schemaVersion": 1,
	"id": "jasperbot",
	"version": "${version}",
	"name": "JasperBot",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/jasperbot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "jasper.bot.JasperBot",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "jasper.bot.client.JasperBotClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "jasper.bot.client.JasperBotDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"jasperbot.mixins.json",
		{
			"config": "jasperbot.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}